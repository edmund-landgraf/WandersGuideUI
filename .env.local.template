
VITE_SUPABASE_URL='http://localhost:8000'
VITE_SUPABASE_KEY='<ANON_KEY>'
VITE_DDDICE_AUTH_KEY='<DDDICE_API_KEY>'
VITE_ENV=development

# Host that serves site-relative /portraits and /backgrounds files for both
# wgui and amba. Portrait saves rewrite `/portraits/...` to this origin, and
# avatars resolve leftover relative paths against it. Defaults to
# https://wgui.wandersguide.site when unset. The MCP server reads
# PUBLIC_ASSET_ORIGIN or this same variable.
# VITE_PUBLIC_ASSET_ORIGIN='https://wgui.wandersguide.site'

# For admin development only
VITE_CLAUDE_KEY='<CLAUDE_API_KEY>'

# Local GoTrue Google provider (not VITE_ — never sent to the browser)
GOOGLE_CLIENT_ID='<GOOGLE_CLIENT_ID>'
GOOGLE_CLIENT_SECRET='<GOOGLE_CLIENT_SECRET>'
