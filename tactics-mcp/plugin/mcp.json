{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "wanderers-guide": {
      "type": "streamable-http",
      "url": "https://wgui.wandersguide.site/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": ["read", "write"]
          }
        }
      }
    }
  }
}
